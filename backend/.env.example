# SQLite for local development. Use a managed PostgreSQL URL for production.
DATABASE_URL=sqlite:///./bennett_verse.db

# Generate long random secrets. Never publish these.
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_TOKEN=replace-with-a-different-long-random-secret
JWT_HOURS=24

# Set this to the exact student email domain confirmed by Bennett University IT.
ALLOWED_EMAIL_DOMAIN=bennett.edu.in
OTP_MINUTES=10

# SMTP configuration for sending verification codes (example: your email provider's SMTP service).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-app-password
SMTP_FROM=verified-sender@example.com

# Local-only testing: prints OTP in backend terminal. MUST be false in production.
DEV_SHOW_OTP=true

# Set to your frontend origin(s) in production, comma-separated.
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
